#!/usr/bin/env node
const assert = require('assert');

const toUpperCase = (label) => label.toUpperCase();
assert.strictEqual(toUpperCase('this'), 'THIS');

/**
 * Transforma uma intenção em um sigilo.
 *
 * O sigilo é criado mantendo apenas a primeira ocorrência de cada letra.
 * Letras repetidas são substituídas por traços (-).
 *
 * @param {string} intention - A intenção a ser transformada em sigilo
 * @returns {string} O sigilo gerado
 *
 * @example
 * sigil('desejo força') // retorna 'DESJO -ORÇA'
 */
function sigil(intention) {
  // Converte toda a intenção para maiúsculas
  const capsIntention = toUpperCase(intention);

  // Registra quantas vezes cada letra já apareceu
  const netIntention = {};

  // Armazena o resultado final
  const out = [];

  // Percorre cada caractere da intenção
  for (let c of capsIntention.split('')) {
    // Se for uma letra que ainda não apareceu, registra a primeira ocorrência
    if (c !== ' ' && netIntention[c] === undefined) {
      netIntention[c] = 1;

    // Se a letra já apareceu, incrementa o contador
    } else if (c !== ' ' && netIntention[c] !== undefined) {
      netIntention[c] += 1;
    }

    // Mantém espaços e primeira ocorrência de cada letra
    if (c === ' ' || netIntention[c] === 1) {
      out.push(c);

    // Substitui repetições por traços
    } else if (netIntention[c] > 1) {
      out.push('-');
    }
  }

  return out.join('');
}
exports.sigil = sigil;
assert.strictEqual(sigil('this my wish to obtain the strength of a tiger'), 'THIS MY W--- -O -B-A-N --E --R--G-- -F - -----');


if (!module.parent) {
  const args = process.argv.slice(2);
  const { refinarIntencao, obterApiKey } = require('./refinar');

  // Verifica se o usuário quer refinar a intenção
  const deveRefinar = args.includes('--refinar') || args.includes('--polish');
  const intencaoOriginal = args.find(arg => !arg.startsWith('--'));

  if (!intencaoOriginal) {
    console.error('Uso: sigils "sua intenção" [--refinar]');
    console.error('\nOpções:');
    console.error('  --refinar, --polish  Refina a intenção usando OpenRouter antes de gerar o sigilo');
    console.error('\nVariáveis de ambiente:');
    console.error('  OPENROUTER_API_KEY   Chave da API do OpenRouter (obrigatória para --refinar)');
    process.exit(1);
  }

  if (deveRefinar) {
    const apiKey = obterApiKey();

    if (!apiKey) {
      console.error('Erro: Para usar --refinar, configure a variável OPENROUTER_API_KEY');
      console.error('Exemplo: export OPENROUTER_API_KEY="sk-or-v1-..."');
      process.exit(1);
    }

    console.log('Intenção original:', intencaoOriginal);
    console.log('\nRefinando intenção...\n');

    refinarIntencao(intencaoOriginal, apiKey)
      .then(intencaoRefinada => {
        console.log('Intenção refinada:', intencaoRefinada);
        console.log('\nSigilo:', sigil(intencaoRefinada));
      })
      .catch(error => {
        console.error('Erro ao refinar intenção:', error.message);
        console.error('\nUsando intenção original...');
        console.log('Sigilo:', sigil(intencaoOriginal));
      });
  } else {
    console.log(sigil(intencaoOriginal));
  }
}
